
# Copiez ce fichier en .env et remplissez les valeurs

# Base de données (OBLIGATOIRE) 
POSTGRES_USER=supmeal
POSTGRES_PASSWORD=changeme_mot_de_passe_db
POSTGRES_DB=supmeal

#Sécurité JWT (OBLIGATOIRE)
# Générez une clé aléatoire : openssl rand -hex 32
JWT_SECRET=changeme_clé_secrète_très_longue

# URLs (OBLIGATOIRE)
FRONTEND_URL=http://localhost:5173

# Google OAuth (OPTIONNEL)
# Laissez "changeme" pour désactiver la connexion Google
# Pour activer : créez une app sur console.cloud.google.com
GOOGLE_CLIENT_ID=changeme
GOOGLE_CLIENT_SECRET=changeme
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Email/SMTP (OPTIONNEL)
# Laissez "changeme" pour désactiver les emails
# (vérification email et mot de passe oublié ne fonctionneront pas)
# Pour Gmail : activez "Mots de passe des applications" dans votre compte Google
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=changeme
SMTP_PASS=changeme
