generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
enum Role {
  OWNER
  EDITOR
  READER
  COMMENTER
}
model User {
  id                 String    @id @default(uuid())
  email              String    @unique
  password           String?
  name               String
  oauthProvider      String?
  oauthId            String?
  diet               String?
  allergies          String?
  defaultPortions    Int?      @default(4)
  emailVerified      Boolean   @default(false)
  verifyToken        String?
  verifyTokenExpiry  DateTime?
  resetToken         String?
  resetTokenExpiry   DateTime?
  createdAt          DateTime  @default(now())
  recipes         Recipe[]
  cookbookMembers CookbookMember[]
  comments        Comment[]
  messages        Message[]
  mealPlans           MealPlan[]
  sentInvitations     CookbookInvitation[] @relation("InvitedBy")
  receivedInvitations CookbookInvitation[] @relation("InvitedUser")
  following           Follow[] @relation("Follower")
  followers           Follow[] @relation("Following")

  @@unique([oauthProvider, oauthId])
}
model Cookbook {
  id          String   @id @default(uuid())
  name        String
  description String?
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  members     CookbookMember[]
  recipes     Recipe[]
  messages    Message[]
  invitations CookbookInvitation[]
}
model CookbookMember {
  id         String   @id @default(uuid())
  cookbookId String
  userId     String
  role       Role     @default(READER)
  joinedAt   DateTime @default(now())
  cookbook Cookbook @relation(fields: [cookbookId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([cookbookId, userId])
}
model Recipe {
  id          String   @id @default(uuid())
  title       String
  prepTime    Int?
  cookTime    Int?
  servings    Int?
  source      String?
  imageUrl    String?
  isFavorite  Boolean  @default(false)
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  userId      String?
  cookbookId  String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cookbook    Cookbook? @relation(fields: [cookbookId], references: [id], onDelete: Cascade)
  ingredients Ingredient[]
  steps       Step[]
  tags        RecipeTag[]
  comments    Comment[]
  mealPlans   MealPlan[]
}
model Ingredient {
  id       String  @id @default(uuid())
  recipeId String
  name     String
  quantity Float?
  unit     String?
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
}
model Step {
  id          String @id @default(uuid())
  recipeId    String
  order       Int
  instruction String
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
}
model Tag {
  id   String @id @default(uuid())
  name String @unique
  type String?
  recipes RecipeTag[]
}
model RecipeTag {
  recipeId String
  tagId    String
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)
  @@id([recipeId, tagId])
}
model MealPlan {
  id       String   @id @default(uuid())
  userId   String
  recipeId String
  date     DateTime
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
}
model Comment {
  id        String   @id @default(uuid())
  recipeId  String
  userId    String
  content   String
  createdAt DateTime @default(now())

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}
model Message {
  id         String   @id @default(uuid())
  cookbookId String
  userId     String
  content    String
  createdAt  DateTime @default(now())

  cookbook Cookbook @relation(fields: [cookbookId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REFUSED
}

model CookbookInvitation {
  id            String           @id @default(uuid())
  cookbookId    String
  invitedById   String
  invitedUserId String
  role          Role             @default(READER)
  status        InvitationStatus @default(PENDING)
  createdAt     DateTime         @default(now())

  cookbook      Cookbook @relation(fields: [cookbookId], references: [id], onDelete: Cascade)
  invitedBy     User     @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)
  invitedUser   User     @relation("InvitedUser", fields: [invitedUserId], references: [id], onDelete: Cascade)

  @@unique([cookbookId, invitedUserId])
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower    User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
}
